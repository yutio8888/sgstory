	continueTitle: '继续游戏',
	savesTitle: '存档与读档',
	savesHeaderBrowser: '浏览器存档',
	savesHeaderDisk: '文件存档',
	savesLabelBrowserClear: '清空全部浏览器存档',
	savesLabelBrowserExport: '将全部浏览器存档导出为一个文件',
	savesLabelBrowserImport: '从文件导入浏览器存档',
