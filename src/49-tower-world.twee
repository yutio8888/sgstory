:: 诺斯塔场景 [script]
/* Narrative adaptation of Jaclyn Lewis, Ascend Nousta's Tower (2023).
 * CC BY-SA 4.0. https://jaclynlewis.itch.io/ascend-noustas-tower
 * https://creativecommons.org/licenses/by-sa/4.0/
 * Changes and additional scenes: docs/TOWER-V2-NARRATIVE.md.
 * Descriptions are read-only projections of the journey state. */
setup.towerRoomsLegacy = [
 {name:'塔基 · 泥土与断阶', past:'你的靴底陷进湿土，旁边是一串尚未被踩乱的哥布林脚印。贴墙的石阶刚砌好，缝里挤出灰浆。杖头的微光扫过阶沿，照出完整的第一步。', present:'你跨进塔门，碎石在脚下滚动。贴墙的阶梯从几步高处断开，泥里露出哥布林的肋骨。你手中的杖刻着 Centuria；微光掠过断口时，那儿闪过一级完整的石阶。', hint:'转动时光杖回到过去，断阶就会变回刚砌好的楼梯。切换不限次数，仍留在原来这一层。'},
 {name:'藏书架 · 藤蔓里的书', past:'你侧身挤过书架。药剂书旁堆着园艺册和养龙书，喂食记录从厚书里滑出一角：肉量逐日增加，页边反复写着出征的日期。', present:'藤蔓穿过空书架，勒住一本旧书。你拨开叶片，摸到封面上的爪痕；养龙书的字样还在，书页虽潮，仍能分开。', hint:'两个时代的养龙书都能读。记下安抚方法，到了塔顶再用。'},
 {name:'学者室 · 会漂浮的文字', past:'你停在门边。哥布林学者踮脚往墙上写字，蘸满墨的笔尖一顿，墨滴便悬住了。楼板上响起脚步声，几支笔同时停下。', present:'你沿着墙上褪色的字迹看过去。大片墨痕已经洇开，只有一个符号笔画清楚，末端悬着一滴墨。你凑近时，它轻轻晃动，却不落下。', hint:'两个时代都能学会浮空符文。记住后可以反复施展，用来绕过守卫，也能向龙展示向上的出口。'},
 {name:'寝室 · 未完成的野心', past:'厚毯吸去了你的脚步声。豪华床铺旁摊着速写簿，画上的哥布林骑龙掠过村庄，身后装满金币。另一页只画了一半：塔顶的横梁挤在龙背上方。', present:'你绕过塌下的床框。霉斑从墙角一直爬到床头，速写簿黏在腐木上，纸边一碰就碎。残页里的横梁轮廓还辨得出来，龙的那一半已经烂没了。', hint:'残页与过去的速写都能让你看清塔顶构造。这条线索可以略过，不妨继续往上走。'},
 {name:'厨房 · 巨型肉食兽', past:'热气扑在你脸上。厨师们围着宰好的巨型肉食兽忙碌，刀刃剁进案板，锅盖随沸汤跳动。门边摞着送餐盘，上方栏杆被敲得当当响：卫兵在催饭。', present:'你推开橱柜，陈年罐藏上积着厚灰。锅铲仍挂在简陋的烟罩下，烟道里一阵风落下来，吹得它轻碰锅沿。楼上没有人应声。', hint:'过去的门边可以免费拿一盘热饭，到上一层送给守卫。也可以直接切到现在，从空厅绕过他们。'},
 {name:'议事厅 · 绳下的会议', past:'你在楼梯口听见争吵。首领在桌边指划，众人争着说下次该抢哪座村庄；天花板吊着的人类骸骨随他们的动静轻晃。通往上层的楼梯在桌后，从这里过去，都在卫兵眼皮底下。', present:'空桌上覆着灰，桌后就是楼梯。你从垂下的旧绳间穿过，几截白骨被风带得轻轻相碰，声音在空厅里传得很远。', hint:'在过去，可以送上热饭，或用学到的浮空符文从上方绕行。切到现在也能直接上楼。三种办法都能安全通过。'},
 {name:'储藏层 · 炸药与遗物', past:'你在门槛前收住脚。木桶从墙根排到楼梯边，桶盖上的火焰与骷髅画得粗大。刺鼻气味钻进鼻子，散落的火药沾在靴尖；你小心避开，不碰桶盖。', present:'你跨过倒下的木桶，走近几具人类骸骨。灰里留着巨剑与卷轴压出的长痕，骨指下有一道护符的细链印。遗物曾落在这里，没能随主人走出塔。', hint:'现在的遗物可以安全拿走：护符能用三次，防火卷轴能护住一次取宝。过去的炸药不必动。'},
 {name:'便壶层 · 屏住呼吸', past:'还没走完楼梯，你就屏住了呼吸。一排便壶贴墙摆着，留给落脚的地方很窄。你收紧衣角，从壶沿旁侧身挤过。', present:'墙边的便壶已经不见，石缝里的气味却仍让你皱起鼻子。你尽量靠着楼梯站，往上看见兵营门边的铁架。', hint:'这里没有需要取走的东西。沿楼梯上去，就是兵营。'},
 {name:'兵营 · 耐火的盾', past:'你挤进床铺与武器架之间。多数挂钩空着，挂防火盾的那排架子上留有烧灼的刻痕。盾后护住的墙面却很干净，几块弧形边界清清楚楚。', present:'折叠铁床陷进烂透的床垫，锈屑从武器架上掉下来。你抬头看见空盾钩，钩下那块没被熏黑的墙，仍留着盾牌的形状。', hint:'过去还有防火盾可取，拿到后可反复使用。防火卷轴也能保护一次取宝；两者有其一就够。'},
 {name:'驯龙层 · 火留下的人形', past:'铁钩敲在盾面上，你停住脚步。全副武装的驯龙者堵住通往塔顶的梯子，朝你摆手，示意退下。头顶传来细低的呜咽，他们立刻抬起铁钩。', present:'你扶住梯子，热气从上方压下来。四壁烧得漆黑，一道人形焦痕留在梯旁，手臂举起的地方格外清楚。如今入口空着，你可以爬上去。', hint:'过去的驯龙者不会让路。切到现在就能上塔顶；无论在哪个时代，你都可以切换或下楼。'},
 {name:'塔冠 · 诺斯塔', past:'你站在梯口，听见鳞片擦过木梁。刚孵出的诺斯塔缩在梁下，目光总往下面的铁钩上落。它恨那些驯龙者，说过等长大就要把他们烧个精光；可每次楼下传来动静，它的尾巴都会贴紧身体。', present:'你抬头时，一只眼睛也正盯着你。诺斯塔盘在金币和冒险者遗物上，脊背已顶住屋梁，却仍把双翼紧紧收拢。“出不去。”它低声说。梁木随着它的呼吸吱呀作响。', hint:'先读养龙书，再到过去倾听幼龙、许下承诺。回到现在，用浮空符文或尚有次数的护符展示出口，就能帮它离开。若要取宝，先备好防火盾或卷轴。'}
];

setup.towerRooms = [
 {name:'塔基 · 泥土与断阶', past:'湿土里印着一串哥布林脚印。刚砌好的石阶贴墙向上，灰浆还挤在缝外。你手中的森图里亚之杖安静下来，方才的断口成了可以落脚的第一步。', present:'门内的石阶从几步高处断开，泥里露出哥布林的肋骨。你握着从白骨旁拾起的杖，Centuria 的刻字抵住掌心。杖头的微光掠过断口，一级完好的阶沿闪了一下。塔顶传来木头受压的闷响。', hint:'杖头的光曾照出完好的阶梯。试着转动它，再观察同一处断口。'},
 {name:'藏书架 · 藤蔓里的书', past:'药剂书旁堆着园艺册与养龙书。喂食记录从书中滑出：肉量逐日增加，页边却只写着出征日期。有一页被反复折起，折痕旁画着张开的手。', present:'藤蔓穿过空书架，勒住一本养龙书。封面留下细小的爪痕，正好够一只幼兽按住。风翻动书角，露出与喂食表不同的字迹。', hint:'两个时代都能读到养龙书。留意它怎样区分“听从命令”和“肯开口”。'},
 {name:'学者室 · 会漂浮的文字', past:'哥布林学者踮脚往墙上写字。笔尖一顿，墨滴便悬在半空；他默数片刻，赶在墨滴落下前接住它。楼板上传来重物拖动的声音，他把袖子捋到腕上，继续写。', present:'大片墨痕已经洇开，只有一个符号仍然清楚。你凑近时，笔画末端的一滴墨微微上浮；过了一会儿，它又回到原处。上方垂下的绳影掠过墙面。', hint:'这段符文只能让东西浮起一分钟。先记住笔顺，再想一想：一分钟之后，谁来托住重量？'},
 {name:'寝室 · 画里的村庄', past:'厚毯吸去你的脚步声。豪华床铺旁摊着速写：哥布林骑龙掠过村庄，金币从袋口洒出。另一页画着塔顶，横梁下面留给龙的空白比床铺还小。床头的出征账册压着一枚印章，几条命令的落款却被反复描粗。', present:'床框塌在霉斑里，速写簿黏住腐木。骑手和金币先烂掉了，塔顶横梁的线条却还辨得出；纸上那一点空隙，恰好与头顶传来的挤压声相合。', hint:'看清横梁怎样搭在墙上。过去的账册也有异常：落款为什么要反复描粗？'},
 {name:'厨房 · 肉香与烟道', past:'厨师围着宰好的巨型肉食兽忙碌，锅盖随沸汤跳动。门边摞着送餐盘，上方栏杆敲得当当响：卫兵在催饭。简陋烟罩下，浓烟被堵回厨师脸上；他一边咳嗽，一边把锅往旁边挪。', present:'陈年罐藏蒙着厚灰，锅铲还挂在烟罩下。塔顶的一声低吼沿烟道压下来，带着烫人的灰味。烟道在墙内转向上层，响声沿着它传来。', hint:'烟罩旁的长刷能伸进狭窄的检修口。沿烟道向上找，看看哪一层把热烟堵了回来。'},
 {name:'议事厅 · 绳下的名字', past:'首领们围桌争论下次该抢哪座村庄。悬吊的人类骸骨随拍桌声摇晃，桌边的人提到驯龙者的命令，却没人肯让旁人看清落款。通往上层的楼梯在卫兵身后。', present:'灰覆盖了议事桌，旧绳从梁上垂到肩头。桌后无人把守，楼梯敞着。你绕过几截白骨，它们轻碰的声音比方才的争吵传得更远。', hint:'送饭、从高处绕行或换个时代，都能避开卫兵。现在垂下的旧绳还有结实的中段；过去的争吵中，似乎藏着可以对证的事。'},
 {name:'储藏层 · 三道刻痕', past:'炸药桶从墙根排到楼梯边，桶盖画着火焰与骷髅。散落的火药沾住靴尖，你停了下来。楼上的热气沿石缝往下渗；这里装的并不只是将来某次出征的东西。', present:'倒下的桶间躺着几具人类骸骨。巨剑横在白骨旁，防火卷轴塞在裂开的皮袋里；一截细链绕住骨指，护符上的三道刻痕暗暗发亮。井口忽然响起人声。你探头看见一位抄写员伏在断裂的吊架上，他的水壶还在摇：“别踩边沿——它刚塌过一次。”', hint:'护符能托住沉重吊架，但会用掉一次机会。浮空能让一个人下去，接下来的攀扶还需要可靠的绳索。'},
 {name:'便壶层 · 堵住的气息', past:'一排便壶挤住窄道。你收紧衣角，避开壶沿；便壶下的排烟槽积满污泥，热气从小小的检修口挤回来。', present:'便壶早已不见，石缝里的气味却留了下来。排烟井的闸门沉在锈槽里，墙面污垢盖住了原先的检修位置。再上一层，就是兵营。', hint:'沉闸能被护符托起。若不想消耗刻痕，比较两时代的污垢与检修口，再找一件够长的清理工具。'},
 {name:'兵营 · 盾后的墙', past:'床铺与武器架挤满房间。防火盾挂在烧灼的木架上，盾后护住的墙面却很干净。床头留着匆忙起身踢翻的水盆，头顶又响了一声铁器。', present:'铁床陷进腐烂的床垫，武器架一碰便掉下锈屑。空挂钩下还留着盾形的浅色墙面。沉重的铁床架压住一本名册，露在外面的半页写着罹难者的姓名。你试着抽动纸边，又停住了：再用力，名字就会随纸一起撕开。', hint:'过去可以取防火盾；现在床架下的名册是可错过的支线。取回它需要留一道护符刻痕，没有免费替代，也不会决定主结局。'},
 {name:'驯龙层 · 铃声之后', past:'全副武装的驯龙者堵住梯口，铁钩敲在盾上。头顶刚响起一声细低的呜咽，他们便抬手去碰传令铃；呜咽立刻停了，只剩爪子刮木头的声音。你被示意退下。', present:'梯旁留着一道举起手臂的人形焦痕。驯龙者已经不在，传令铃却还悬着，热风使它偶尔发出轻响。每响一下，楼上的鳞片便骤然擦紧木梁。', hint:'过去的梯口有人把守，现在已经空了。仔细听铃响时楼上的反应：人不在了，命令的声音却还在。'},
 {name:'塔冠 · 诺斯塔', past:'幼龙蜷在木梁下，尾巴紧贴肚腹。它先露出牙：“长大以后，我把他们全烧掉。”楼下一响，它便把嘴闭住，盯着梯口的铁钩。它一只前爪按住另一只，努力不让爪尖发抖。', present:'诺斯塔盘在金币与冒险者遗物上，脊背顶着屋梁，双翼仍紧紧收拢。“出不去。”它盯着梁下那一点缝隙，像身体仍只有刚孵出时那么大。你一抬手，它就缩回颈子，先看你的手里有没有铁钩。', hint:'先让幼龙愿意说话，再留意成年龙被什么困住：头顶的梁、扑面的烟，还有命令的声音。若想谈成约定，塔中记录与活下来的见证者也有用。'}
];
setup.towerDescription = (s) => {
 if (s.version !== 2 && setup.towerRoomsLegacy) return setup.towerRoomsLegacy[s.floor][s.era];
 const past = s.era === 'past';
 let text = setup.towerRooms[s.floor][s.era];
 if (s.floor === 1 && s.book) text += ' 你已经抄下折页里的话。再看那些出征日期，你发现整张表里没有一处问过龙愿不愿意。';
 if (s.floor === 2 && s.rune) text += ' 那段笔顺已经在你手记里。你握住杖，记起东西浮起后还会落下。';
 if (s.floor === 3 && s.sketch) text += ' 你记下了横梁的承重点。这里没有封印的画法，只有木头、石墙，以及当年没人肯多留的空间。';
 if (s.floor === 3 && past && s.ledger) text += ' 你已抄下账册中的命令与暗记，原册仍留在床头。';
 if (s.floor === 4) {
  if (past && s.drainCleared) text = '厨师围着宰好的巨型肉食兽忙碌，门边摞着送餐盘。烟罩终于抽走浓烟，他把锅挪回灶心，擦了擦熏红的眼角。';
  if (past && s.guards) text += ' 卫兵已让你通过，送餐盘不必再拿。';
  else if (past && s.meal) text += ' 你端着的热饭正烫手，门边的厨师已转回灶台。';
  if (!past) text += s.brush ? ' 烟罩长刷已经收在你身上，挂钩空着。' : ' 烟罩旁挂着一柄长刷，刷毛虽然发黑，柄还是结实的。';
  if (!past && s.vented) text = '烟罩下有风向上流。你把手伸过去，灰尘从指间升起；原先压回来的热烟，如今有了离开塔身的路。' + (s.brush ? '长刷已在你身上。' : '烟罩旁还挂着一柄长刷。');
 }
 if (s.floor === 5) {
  if (past && s.decree) text = '首领把撤令的文书重重压在桌上，墨迹还没有干。有人想再提村庄，被同伴拽住袖子。悬吊的骸骨仍在，这份撤令不能把已经发生的事抹掉；至少，下一次出征不再借那枚落款发号施令。';
  if (!past && s.decree) text += ' 桌边留着撤销出征的刻记。你用指尖拂过那道字，想起当年按在湿墨旁的手。';
  if (past && s.guards) text += ' 通往上层的路已经打通，你无需再让卫兵放行。';
  if (!past) text += (s.ropeTaken || s.rope) ? ' 结实的那段旧绳已被你取走，梁上只剩断头。' : ' 其中一段旧绳还很结实，足够打结承重。';
 }
 if (s.floor === 6 && !past) {
  text = s.loot ? '遗物已经收进行囊，白骨旁只剩巨剑压出的长痕与细链印。' : '倒下的桶间躺着几具人类骸骨。巨剑横在白骨旁，防火卷轴塞在裂开的皮袋里；护符的三道刻痕暗暗发亮。';
  text += s.witness ? ' 抄写员已坐到安全的墙边。他把刚才攥得发皱的纸慢慢展平：“我下来是想核对那些名字。差一点，倒要别人来替我认名字。”他给你指出古账册核验落款的暗记，随后系紧水壶，准备沿楼梯离塔。' : ' 井下有人喊你。近期来查遗迹的抄写员伏在刚断裂的吊架上，指节因攥紧木头而发白。“先别伸手，这架子受不住两个人。”';
 }
 if (s.floor === 7) {
  if (past && s.drainCleared) text = '污泥已从排烟槽里清走，检修口露出完整的轮轴。你收回长刷，热气终于不再扑到脸上。便壶仍挤在脚边，留下的窄道却好走了一点。';
  if (!past && s.drainCleared && !s.vented) text = '原先厚厚的污垢不见了，墙边露出检修轮。轮缘有使用过的磨痕，连接闸门的轴却仍完整。你伸手握住它，还没用力。';
  if (!past && s.vented) text = '沉闸已经固定在止回槽里，热烟向井中流去。你不必再屏着气等烟散开；脚下那些顽固的旧气味，也被风带淡了一些。';
 }
 if (s.floor === 8 && past && s.shield) text = '你取走防火盾的挂钩已经空了，盾形的浅色墙面完整露出来。防火盾背在你身后；这里不需要再搜一次。';
 if (s.floor === 8 && !past && s.memorial) text = '铁床架已经落回地面，压住的地方只剩纸张的浅印。你把取回的名册裹好，放进不会磨到纸角的位置。空盾钩下的墙仍然发白；那些名字却不必再留在这里了。';
 if (s.floor === 9 && s.bellSilent) text = past ? '驯龙者仍横在梯口，举起铁钩催你下去。传令铃的位置只剩空钩；头顶的呜咽没有立刻停，末尾竟带出了一次完整的呼气。' : '人形焦痕旁只剩挂铃的空钩。热风掠过时，楼上的鳞片不再骤然收紧。你攀住梯子，听见一次比先前更长的呼吸。';
 if (s.floor === 10) {
  if (past && s.promise) text = '幼龙把一只前爪从身下挪出来，搁在你面前。它不再谈怎样烧死驯龙者，转而问：“没有人叫我走的时候，我也能出去吗？”你等它抬起头，才点头。它望了望梁缝里的亮处，尾巴终于离开肚腹。';
  if (!past && s.promise) text = '诺斯塔低下头，在你面前搁下一只巨大的前爪。“你说过，等我愿意。”它认出了你，却仍收着翅膀。爪边的金币滑下去，它没有看；它在等你把下一步说清楚。';
  if (!past && s.exitOpen && !s.promise) text = '诺斯塔盘在金币与冒险者遗物上，双翼仍紧紧收拢。屋顶已经打开，它却只盯着自己的前爪。你靠近一步，它便先看你的手里有没有铁钩。';
  if (!past && s.beamWedged && !s.exitOpen) text += ' 巨剑已楔进横梁的支点，剑柄露在侧墙边。梁稍稍松动，仍没有让出出口。';
  if (!past && s.exitOpen) text += ' 横梁已经让开，日光落在它以前够不到的鳞片上。它把鼻尖探进亮处，又慢慢缩回来。';
  if (!past && s.vented) text += ' 热烟沿通畅的烟道散去，它终于能不带咳声地吸满一口气。';
  if (!past && s.bellSilent) text += ' 楼下没有铃响。诺斯塔等了一会儿，才发现自己不必在呼吸间隙等待命令。';
  if (!past && s.ledger && s.witness) text += ' 你带来的记录里有村庄的名字，也有逃出塔的人的话。它垂眼听着；这一次，要谈的不只是它怎样离开。';
 }
 return text;
};
