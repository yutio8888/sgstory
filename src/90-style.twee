:: StoryStyleSheet [stylesheet]
/* ── 迷雾森林 · 暗色主题 ─────────────────────────────── */
body {
	background-color: #191722;
	background-image:
		radial-gradient(ellipse at 50% -10%, #2c2742 0%, transparent 55%),
		radial-gradient(ellipse at 50% 110%, #20282b 0%, transparent 50%);
	color: #e6dfd2;
	font-family: 'LXGW WenKai', 'LXGW WenKai Screen', 'Kaiti SC', 'STKaiti', 'KaiTi', 'Noto Serif SC', serif;
	-webkit-font-smoothing: antialiased;
	text-rendering: optimizeLegibility;
}

#passages {
	max-width: 620px;
	margin: 2em auto;
	padding: 0 1em;
}

.passage {
	font-size: 1.15em;
	line-height: 2.1;
	text-align: left;
	letter-spacing: 0.04em;
	text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
	animation: fadein 0.6s ease;
}

@keyframes fadein {
	from { opacity: 0; transform: translateY(6px); }
	to   { opacity: 1; transform: none; }
}

/* 链接 */
.passage a.link-internal {
	color: #a9c0da;
	border-bottom: 1px dotted rgba(169, 192, 218, 0.45);
	text-decoration: none;
}
.passage a.link-internal:hover {
	color: #dde8f4;
	background: rgba(169, 192, 218, 0.10);
}
.passage a.link-internal:active {
	color: #eccf96;
}

/* 侧边栏 */
#story {
	border-right: none;
}
#menu li a {
	color: #8b8497;
}
#menu li a:hover {
	color: #d3e2f5;
}

/* 血条 */
.hpbar {
	position: relative;
	height: 22px;
	background: #2c2836;
	border: 1px solid #4a4358;
	border-radius: 11px;
	overflow: hidden;
	margin: 0.8em auto;
	max-width: 320px;
}
.hpbar-fill {
	height: 100%;
	transition: width 0.4s ease;
	border-radius: 11px 0 0 11px;
}
.hpbar-text {
	position: absolute;
	inset: 0;
	text-align: center;
	font-size: 0.78em;
	line-height: 22px;
	color: #fff;
	text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* 受伤提示 */
.damage-flash {
	display: block;
	color: #da8a95;
	margin: 0.4em 0;
}

/* 标题画面 */
.title-card {
	text-align: center;
	margin: 2.5em 0;
}
.title-card h1 {
	font-size: 2.4em;
	letter-spacing: 0.35em;
	margin: 0 0 0.3em;
	color: #d3e2f5;
	text-shadow: 0 0 24px rgba(157, 180, 212, 0.45);
}
.title-card .subtitle {
	color: #8b8497;
	font-size: 0.9em;
	letter-spacing: 0.2em;
}
.title-card .engine-credit {
	margin-top: 2.2em;
	font-size: 0.72em;
	color: #5f5a6d;
	letter-spacing: 0.05em;
}

/* 结局画面 */
.ending-card {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1.2em 1.6em;
	margin: 1.5em 0;
	background: rgba(20, 18, 28, 0.7);
	box-shadow: 0 0 32px rgba(0, 0, 0, 0.5) inset;
}
.ending-card h2 {
	text-align: center;
	letter-spacing: 0.15em;
	margin-top: 0;
}
.ending-card table {
	margin: 0 auto;
	border-spacing: 1em 0.3em;
	font-size: 0.95em;
}
.ending-card td:first-child {
	color: #8b8497;
	padding-right: 0.5em;
	text-align: right;
}

/* ── 车卡流程 ── */
.chargen-card {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1.2em 1.5em;
	background: rgba(20, 18, 28, 0.7);
}
.mode-expert {
	margin-top: 1.2em;
	text-align: center;
	padding: 0.7em;
	border-top: 1px dashed #4a4358;
}
.mode-expert a.link-internal {
	color: #8b8497;
	font-size: 0.88em;
}
.mode-expert a.link-internal:hover {
	color: #d3e2f5;
}
.chargen-progress {
	color: #8b8497;
	font-size: 0.8em;
	letter-spacing: 0.2em;
}
.chargen-card h3 {
	letter-spacing: 0.2em;
	margin: 0.3em 0;
}
.chargen-intro {
	color: #c8c0b0;
}
.choices {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
	gap: 0.8em;
	margin-top: 1em;
}
.choice-card {
	border: 1px solid #3c3648;
	border-radius: 8px;
	padding: 0.9em 1em;
	background: rgba(44, 40, 54, 0.5);
	display: flex;
	flex-direction: column;
	gap: 0.4em;
	transition: border-color 0.2s, transform 0.2s;
}
.choice-card:hover {
	border-color: #9db4d4;
	transform: translateY(-2px);
}
.choice-name {
	font-size: 1.1em;
	letter-spacing: 0.15em;
	color: #d3e2f5;
}
.choice-desc {
	color: #a89f92;
	font-size: 0.9em;
	flex: 1;
}
.choice-effect {
	color: #7fb285;
	font-size: 0.82em;
}
.choice-card a.link-internal {
	text-align: center;
	display: block;
	border: 1px solid #4a4358;
	border-radius: 6px;
	padding: 0.3em 0;
}

/* ── 检定结果框 ── */
.check-result {
	border-left: 3px solid;
	border-radius: 4px;
	padding: 0.5em 0.9em;
	margin: 0.8em 0;
	font-size: 0.95em;
	background: rgba(44, 40, 54, 0.5);
}
.check-result.check-success {
	border-color: #74b57c;
}
.check-result.check-fail {
	border-color: #d3707f;
}
.check-dice {
	color: #9db4d4;
	font-family: monospace;
}

/* ── 角色卡总览 ── */
.charsheet {
	border: 1px solid #4a4358;
	border-radius: 10px;
	padding: 1.2em 1.6em;
	background: rgba(20, 18, 28, 0.7);
}
.charsheet h2 {
	text-align: center;
	letter-spacing: 0.15em;
	margin-top: 0;
}
.charsheet-line {
	text-align: center;
	color: #8b8497;
}
.ability-table {
	margin: 1em auto;
	border-spacing: 0.6em 0.3em;
	text-align: center;
}
.ability-table th {
	color: #8b8497;
	font-weight: normal;
	font-size: 0.85em;
}
.charsheet-rows {
	display: flex;
	flex-direction: column;
	gap: 0.3em;
}
.charsheet-rows .label {
	color: #8b8497;
	display: inline-block;
	min-width: 5.5em;
}

/* Nousta: ink, weathered paper, cold ruins and warm remembered rooms. */
#passages:has(.tower-shell), #passages:has(.nousta-title), #passages:has(.tower-chargen-note) { max-width: 1120px; }
body:has(.tower-shell), body:has(.nousta-title) { background: #101c20; }
.tower-shell, .nousta-title { --ink: #e5e7db; --muted: #aebbb7; --accent: #9dc9c4; --line: #3f5354; --surface: #19292d; color: var(--ink); letter-spacing: .025em; text-shadow: none; }
.tower-shell[data-era="past"] { --ink: #f1e5ce; --muted: #c9b99f; --accent: #e4bd79; --line: #65543c; --surface: #302920; }
.tower-shell { background: var(--surface); border: 1px solid var(--line); border-radius: 4px; box-shadow: 0 18px 70px #0004; overflow: hidden; }
.tower-heading { min-height: 270px; padding: 24px 34px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; background-image: linear-gradient(180deg, #101b2066, #101b2022 30%, #142326f5), var(--tower-art-present, var(--tower-art, none)); background-color: #203638; background-size: cover; background-position: center 42%; border-bottom: 1px solid var(--line); }
[data-era="past"] .tower-heading { background-image: linear-gradient(180deg, #38271a55, #60432044 30%, #302920fa), var(--tower-art-past, var(--tower-art, none)); }
.tower-heading-top { display: flex; justify-content: space-between; align-items: center; gap: 1em; }
.tower-kicker { color: var(--accent, #d6bf90); font: 11px/1.8 sans-serif; letter-spacing: .18em; margin: 0; }
.tower-floor { font: 12px/1.8 monospace; letter-spacing: .15em; color: #ece8d9; }
.tower-heading h1 { font-size: clamp(28px, 4vw, 42px); line-height: 1.3; margin: 7px 0 0; color: #f5eedc; font-weight: normal; letter-spacing: .12em; }
.tower-era { color: #e3e2ce; font-size: 13px; margin: 0; }
.tower-layout { display: grid; grid-template-columns: minmax(0, 1fr) 255px; }
.tower-main { padding: 30px 34px; min-width: 0; }
.tower-objective { border-bottom: 1px solid var(--line); padding-bottom: 17px; margin-bottom: 22px; }
.tower-objective p { color: var(--muted); font-size: 14px; line-height: 1.8; margin: 5px 0 0; }
.tower-prose { font-size: 18px; line-height: 2.05; }
.tower-prose p { margin: 1em 0 1.5em; white-space: pre-line; }
.tower-feedback { border-left: 2px solid var(--accent); background: #ffffff06; padding: 12px 16px; font-size: 15px; line-height: 1.85; color: var(--ink); }
.tower-section-title { font-size: 12px; color: var(--muted); font-weight: normal; letter-spacing: .18em; margin: 26px 0 12px; }
.tower-section-title span { opacity: .4; padding-left: 10px; }
.tower-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 0 0 26px; }
.tower-action-card { position: relative; border: 1px solid var(--line); border-radius: 3px; padding: 14px 16px; background: #ffffff04; transition: border-color .2s, background .2s; }
.tower-action-card:hover, .tower-action-card:focus-within { background: #ffffff09; border-color: var(--accent); }
.passage .tower-action-card a.link-internal { color: var(--ink); display: block; font-size: 15px; line-height: 1.65; border: 0; padding: 0; min-height: 30px; overflow-wrap: anywhere; }
.tower-action-card a::after { content: ''; position: absolute; inset: 0; }
.tower-action-card[data-kind="history"] { border-color: var(--accent); background: #96c5bc0c; }
.tower-action-card[data-kind="ending"] { grid-column: 1 / -1; border-color: #b69662; }
.tower-action-cost, .tower-action-hint { font-size: 12px; line-height: 1.7; margin: 7px 0 0; color: var(--muted); }
.tower-action-cost { color: var(--accent); }
.tower-journal { padding: 22px 19px; border-left: 1px solid var(--line); background: #00000016; min-width: 0; }
.tower-panel { border-top: 1px solid var(--line, #4b5356); padding: 12px 0; font-size: 14px; line-height: 1.85; }
.tower-panel summary { cursor: pointer; color: var(--ink, #e5e7db); padding: 5px 0; min-height: 28px; font-size: 13px; }
.tower-panel summary span { color: var(--muted); font-size: 11px; margin-left: 8px; }
.tower-panel p, .tower-panel li { color: var(--muted); }
.tower-map-panel { border-top: 0; padding-top: 0; }
.tower-map-legend { display: flex; justify-content: space-between; font-size: 10px; color: var(--muted); margin: 6px 0; }
.tower-map { list-style: none; padding: 0; margin: 0; }
.tower-map li { display: grid; grid-template-columns: 21px minmax(0,1fr) 35px; gap: 5px; align-items: center; border-bottom: 1px solid #ffffff0a; font-size: 12px; padding: 7px 5px; line-height: 1.5; }
.tower-map li.is-current { background: #a1c9be14; color: var(--ink); box-shadow: inset 2px 0 var(--accent); }
.tower-map-number { font: 10px/1.5 monospace; opacity: .65; }
.tower-map-dots { text-align: right; letter-spacing: 1px; font-size: 11px; }
.tower-map-dots span:first-child { color: #d9b783; }
.tower-map-dots span:last-child { color: #9ac7c6; }
.tower-inventory { list-style: none; padding: 0; margin: 6px 0; }
.tower-inventory li { padding: 9px 0; border-bottom: 1px solid #ffffff09; }
.tower-inventory strong { color: var(--ink); display: block; font-size: 13px; font-weight: normal; }
.tower-inventory span { display: block; font-size: 11px; line-height: 1.8; margin-top: 3px; }
.tower-notes { padding-left: 20px; }
.tower-notes li { margin: 0 0 14px; font-size: 12px; }
.tower-ending { border-color: var(--line); background: #ffffff03; padding: 24px; margin-top: 0; }
.tower-ending h2 { font-size: 25px; font-weight: normal; text-align: left; margin: 12px 0 22px; }
.nousta-title { display: grid; grid-template-columns: 1.05fr 1fr; border: 1px solid #455253; background: #19272b; box-shadow: 0 24px 80px #0005; }
.nousta-cover { padding: 42px 35px; min-height: 500px; box-sizing: border-box; background-image: linear-gradient(180deg, #0c1b2399, #0c1b2320 45%, #0c1b23bb), var(--tower-art, none); background-size: cover; background-position: center; position: relative; display: flex; flex-direction: column; }
.nousta-cover h1 { font-size: clamp(48px, 6vw, 72px); font-weight: normal; line-height: 1.25; letter-spacing: .18em; margin: 38px 0 12px; text-shadow: 0 2px 22px #08121b; color: #f5efdb; }
.nousta-en { font: 11px/1.8 sans-serif; letter-spacing: .26em; color: #e2d5b8; }
.nousta-cover-line { margin: auto 0 0; padding-top: 35px; font-size: 15px; line-height: 2; color: #e1e4d8; }
.nousta-start { padding: 46px 34px 32px; font-size: 17px; line-height: 2; align-self: center; }
.nousta-start label { display: block; font-size: 13px; color: #c1c7b8; margin: 28px 0 8px; }
.nousta-start input { width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; border: 1px solid #586764; background: #0f1d21; color: #f0e7d4; padding: 10px 14px; font-family: inherit; border-radius: 2px; }
.passage .nousta-start-link a { display: block; background: #d3bc85; color: #17252a; border: 1px solid #e1cc9d; text-align: center; padding: 12px 18px; font-size: 16px; margin-top: 17px; border-radius: 2px; }
.passage .nousta-start-link a:hover { color: #17252a; background: #e7d6ae; }
.nousta-small { color: var(--muted, #afb9b5); font-size: 12px; line-height: 1.85; }
.forest-door { grid-column: 1 / -1; padding: 18px 30px; border-top: 1px solid #455253; font-size: 14px; }
.forest-door summary { cursor: pointer; padding: 6px 0; color: #c6c6b2; }
.nousta-credits { grid-column: 1 / -1; margin: 0; padding: 16px 30px; color: #a0aaa6; background: #0002; font: 10px/1.9 sans-serif; }
.tower-chargen-note { padding: 10px 0 24px; }
.tower-chargen-note h1 { font-weight: normal; margin: 10px 0; font-size: 32px; }
.tower-chargen-note p:last-child { color: #b9c3bc; font-size: 16px; }
.passage a:focus-visible, summary:focus-visible, input:focus-visible, button:focus-visible { outline: 3px solid #efcf83; outline-offset: 4px; }
@media (max-width: 1100px) { .tower-layout { grid-template-columns: minmax(0,1fr) 220px; } .tower-main { padding: 24px; } .tower-actions { grid-template-columns: 1fr; } .nousta-title { grid-template-columns: 1fr; } .nousta-cover { min-height: 410px; background-position: center 35%; } .nousta-cover h1 br { display: none; } .nousta-cover h1 { font-size: 54px; } }
@media (max-width: 760px) { #passages:has(.tower-shell), #passages:has(.nousta-title) { margin: 1em auto; padding: 0 .5em; } .tower-layout { grid-template-columns: 1fr; } .tower-journal { border-left: 0; border-top: 1px solid var(--line); padding: 18px 22px; } .tower-heading { min-height: 230px; padding: 20px 22px; } .tower-main { padding: 22px; } .tower-map li { grid-template-columns: 26px minmax(0,1fr) 50px; padding: 7px 10px; } .tower-prose { font-size: 17px; } .nousta-start { padding: 26px 24px; } .nousta-cover { padding: 28px 24px; min-height: 360px; } .nousta-cover h1 { font-size: 44px; } .nousta-cover .tower-kicker { font-size: 10px; } .forest-door, .nousta-credits { padding-left: 24px; padding-right: 24px; } .tower-inventory { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 0 18px; } }
@media (max-width: 400px) { .nousta-cover h1 { font-size: 37px; } .tower-main { padding: 18px; } .tower-heading { padding: 18px; } .tower-inventory { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: reduce) { .passage { animation: none; } *, *::before, *::after { transition: none !important; scroll-behavior: auto !important; } }

/* Give small screens the reading width left after the stowed save menu. */
@media (max-width: 760px) {
  #ui-bar.stowed ~ #story:has(.tower-shell),
  #ui-bar.stowed ~ #story:has(.nousta-title),
  #ui-bar.stowed ~ #story:has(.tower-chargen-note) { margin: 16px 8px 24px 40px; }
  .tower-heading h1 { text-wrap: balance; letter-spacing: .06em; }
}

.tower-statusbar { display:flex; flex-wrap:wrap; gap:8px 24px; padding:10px 22px; border-bottom:1px solid var(--line); color:var(--accent); font-size:13px; line-height:1.7; }
