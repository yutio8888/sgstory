			{
				name: '巫师', desc: '你钻研古老传说与奥秘，试着读懂常人眼中的怪事。', effect: '生命上限：6 + 体质调整值｜熟练：奥秘、历史',
				apply(pc) { pc.max_hp = 6 + Rules.mod(pc.abilities.con); pc.skills.push('奥秘', '历史'); pc.classLabel = '巫师'; },
			},
		],
	},
	{
		title: '技艺',
		intro: '漫长的旅途让你多学了一些本事。选择一组熟练技能；重复获得的熟练不会叠加。',
		options: [
			{ name: '荒野技艺', desc: '你认得可食的浆果，也能从草叶与脚印间察觉动静。', effect: '熟练：生存、察觉',
				apply(pc) { pc.skills.push('生存', '察觉'); } },
			{ name: '市井技艺', desc: '你熟悉街巷里的讨价还价，知道何时直言，何时迂回。', effect: '熟练：游说、欺瞒',
				apply(pc) { pc.skills.push('游说', '欺瞒'); } },
			{ name: '秘闻技艺', desc: '你收集古老咒语的残页，也留心草木与异象的联系。', effect: '熟练：奥秘、自然',
				apply(pc) { pc.skills.push('奥秘', '自然'); } },
		],
	},
	{
		title: '行囊',
		intro: '行囊里还能放下一份装备。你准备带上什么？',
		options: [
			{ name: '火把与绳索', desc: '一支照亮脚下，一卷系住退路。', effect: '火把：照明探洞｜绳索：吊桥体操检定有优势',
				apply(pc) { pc.has_torch = true; pc.has_rope = true; pc.gear.push('火把', '绳索'); } },
			{ name: '长剑', desc: '家传的剑刃保养得当，握柄已被岁月磨得光滑。', effect: '对抗哥布林时，运动检定 +2',
				apply(pc) { pc.gear.push('长剑'); } },
			{ name: '疗伤药膏', desc: '草药气味刺鼻，是你留给伤口的一份准备。', effect: '首次受伤且存活时，自动恢复最多 4 点生命；仅用一次',
				apply(pc) { pc.gear.push('药膏'); } },
		],
	},
	{
		title: '起源专长',
		intro: '那些日积月累的习惯，已成了你的长处。选择一项专长：',
		options: [
			{ name: '警觉', desc: '即使歇脚，你也不忘留意身边细微的声响。', effect: '洞穴察觉检定有优势（与精灵黑暗视觉不叠加）',
				apply(pc) { pc.feats = ['警觉']; } },
			{ name: '坚韧', desc: '漫长的劳作与跋涉，让你比旁人更经得住伤痛。', effect: '生命值上限 +2',
				apply(pc) { pc.feats = ['坚韧']; pc.max_hp += 2; } },
			{ name: '巧手', desc: '灵巧的双手替你做成过不少小活，也攒下一点路费。', effect: '金币 +5',
				apply(pc) { pc.feats = ['巧手']; pc.gold += 5; } },
		],
	},
	{
		title: '命运烙印',
		intro: '最后，选一种伴你上路的信念或禀赋：',
		options: [
			{ name: '勇气', desc: '恐惧并未消失，但你学会了在疼痛中站稳。', effect: '鲁莽挑战中受到的伤害 -1（最终至少受 1 点伤害）',
				apply(pc) { pc.flags.courage = true; } },
			{ name: '机运', desc: '每逢紧要关头，你似乎总能多得一点好运。', effect: '所有检定与豁免 +1',
				apply(pc) { pc.flags.luck = true; } },
			{ name: '学识', desc: '旧书里的记载，让你知道该往宝箱的哪处夹层看。', effect: '发现洞穴宝箱时，额外获得 10 枚金币',
				apply(pc) { pc.flags.lore = true; } },
		],
	},
];

window.Chargen = {
	pick(roundIdx, optIdx) {
		const pc = State.variables.pc;
		const round = ChargenRounds[roundIdx];
		const opt = round.options[optIdx];
		opt.apply(pc);
		pc.skills = [...new Set(pc.skills)]; // 背景与职业可能给同一技能，去重
		pc.picked.push(`${round.title}：${opt.name}`);
		pc.round += 1;
		if (pc.round >= ChargenRounds.length) {
			pc.name = State.variables.player_name || '无名旅人';
			pc.hp = pc.max_hp;
		}
	},

	// 快速模式：一键应用整套预设（8 轮选项索引）
	applyPreset(idx) {
		const picks = ChargenPresets[idx].picks;
		for (let r = 0; r < ChargenRounds.length; r++) this.pick(r, picks[r]);
	},
};

// 三套预设（索引依次对应各轮选项：数组/背景/物种/职业/技艺/行囊/专长/烙印）
window.ChargenPresets = [
	{
		name: '铁卫',
		desc: '矮人战士，曾以佣兵为生。沉稳耐伤，出发前总会备好照明与绳索。',
		summary: '力量17 体质15｜生命14｜火把与绳索｜坚韧 · 勇气',
		picks: [0, 1, 2, 0, 0, 0, 1, 0],
	},
	{
		name: '影手',
		desc: '精灵游荡者，曾在隐修之所生活。步履轻巧、耳目敏锐，愿好运与剑刃伴你过关。',
		summary: '敏捷15 魅力13｜生命10｜长剑：对抗哥布林检定+2｜警觉 · 机运：检定与豁免+1',
		picks: [1, 2, 1, 1, 1, 1, 0, 1],
	},
	{
		name: '秘典',
		desc: '人类巫师，出身学者。身板单薄，却善于从旧闻中找到线索，行囊里备着应急药膏。',
		summary: '智力17 感知15｜生命7｜药膏：受伤存活后恢复最多4点｜巧手 · 学识',
		picks: [2, 0, 0, 2, 2, 2, 2, 2],
	},
];
