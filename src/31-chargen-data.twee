			},
			{
				name: '灵巧型', desc: '你步履轻捷，习惯在危险逼近前寻找落脚之处。', effect: '敏捷15 体质14 力量13 魅力12 感知10 智力8',
				apply(pc) { pc.abilities = { dex: 15, con: 14, str: 13, cha: 12, wis: 10, int: 8 }; },
