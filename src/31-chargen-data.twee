			{
				name: '佣兵', desc: '你护送过商队，也守过城门，知道一份报酬背后有多少风险。', effect: '力量+2 体质+1｜熟练：运动、恐吓｜金币 15',
				apply(pc) { pc.abilities.str += 2; pc.abilities.con += 1; pc.skills.push('运动', '恐吓'); pc.gold += 15; pc.bgLabel = '佣兵'; },
			},
			{
				name: '修行者', desc: '离开隐修之所后，你一路行医问路，来到这座边镇。', effect: '感知+2 魅力+1｜熟练：洞悉、医药｜金币 12',
				apply(pc) { pc.abilities.wis += 2; pc.abilities.cha += 1; pc.skills.push('洞悉', '医药'); pc.gold += 12; pc.bgLabel = '修行者'; },
